{
  "name": "@lovelace_lol/embody",
  "version": "0.0.0",
  "description": "Renderer-agnostic character animation runtime for facial AUs, visemes, and bone-driven motion",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./three": {
      "types": "./dist/three/index.d.ts",
      "import": "./dist/three.js",
      "require": "./dist/three.cjs"
    },
    "./wasm": {
      "types": "./dist/wasm/index.d.ts",
      "import": "./dist/wasm.js",
      "require": "./dist/wasm.cjs"
    },
    "./character-asset-service-worker.js": "./service-worker/character-asset-service-worker.js"
  },
  "files": [
    "dist",
    "service-worker",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup --config tsup.config.mjs && tsc -p tsconfig.declarations.json && npm run wasm:build",
    "dev": "tsup --config tsup.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "npm run rust:test && npm run typecheck",
    "test:exports": "npm run build && node scripts/smoke/package-exports.mjs && node scripts/smoke/morph-authoring.mjs && node scripts/smoke/package-declarations.mjs",
    "test:pack": "npm run build && npm pack --dry-run",
    "extract:humanoid-skeleton-template": "node scripts/extract-humanoid-skeleton-template.cjs",
    "rust:test": "RUSTC=$(rustup which rustc) RUSTDOC=$(rustup which rustdoc) rustup run stable cargo test",
    "rust:wasm-build": "RUSTC=$(rustup which rustc) RUSTDOC=$(rustup which rustdoc) rustup run stable cargo build --target wasm32-unknown-unknown --release",
    "wasm:build": "node scripts/build-wasm.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "three": ">=0.150.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/three": "^0.170.0",
    "three": "^0.170.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.0",
    "wasm-pack": "^0.15.0"
  },
  "keywords": [
    "3d",
    "animation",
    "facial-animation",
    "FACS",
    "action-units",
    "visemes",
    "lip-sync",
    "character-animation",
    "morph-targets",
    "blendshapes",
    "three.js",
    "babylon.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meekmachine/embody.git"
  },
  "bugs": {
    "url": "https://github.com/meekmachine/embody/issues"
  },
  "homepage": "https://github.com/meekmachine/embody#readme",
  "author": "Jonathan Sutton Fields",
  "license": "MIT",
  "packageManager": "npm@10.9.2"
}
